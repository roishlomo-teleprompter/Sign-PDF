/* Shared signatures: private Drive files, immutable revisions, one personal bearer per signer.
 * Recipients submit a PNG and coordinates only. PDFs are always composed on the server.
 * Code.gs supplies config_, appOwner_, pdfBytes_, hash_ and hashBytes_.
 */
var SHARED_HEADERS_=['id','metadata_file','created_at','status','revision','title','original_file','current_pdf','signers','signed','updated_at'];
var sharedPdfLibrary_;
function sharedError_(message,code){const error=new Error(message);if(code)error.code=code;throw error}
function sharedSheet_(create){const ss=personalSheets_().openById(config_().SHEET_ID);let s=ss.getSheetByName('SharedDocuments');if(!s){if(!create)sharedError_('המסמך אינו זמין.');s=ss.insertSheet('SharedDocuments');s.appendRow(SHARED_HEADERS_)}if(s.getLastRow()===0)s.appendRow(SHARED_HEADERS_);if(s.getRange(1,1,1,SHARED_HEADERS_.length).getValues()[0].join('|')!==SHARED_HEADERS_.join('|'))sharedError_('כותרות גיליון המסמכים המשותפים אינן תקינות.');return s}
function sharedFind_(id){if(typeof id!=='string'||!/^[a-f0-9-]{36}$/.test(id))sharedError_('המסמך אינו זמין.');const s=sharedSheet_(),rows=s.getDataRange().getValues();for(let i=1;i<rows.length;i++)if(rows[i][0]===id){const meta=JSON.parse(personalDrive_().getFileById(rows[i][1]).getBlob().getDataAsString());if(meta.id!==id)sharedError_('המסמך אינו זמין.');return {sheet:s,row:i+1,meta}}sharedError_('המסמך אינו זמין.')}
function sharedResolve_(token){if(typeof token!=='string'||!/^[a-f0-9-]{36}\.[a-f0-9-]{72}$/.test(token))sharedError_('הקישור אינו תקין.');const parts=token.split('.'),r=sharedFind_(parts[0]),person=r.meta.people.find(p=>p.tokenHash===hash_(parts[1]));if(!person)sharedError_('הקישור אינו תקין.');if(r.meta.status==='cancelled'||Date.parse(r.meta.expiresAt)<=Date.now())sharedError_('הקישור בוטל או פג תוקפו.');r.person=person;return r}
function sharedSummary_(m,owner){return {id:m.id,title:m.title,status:m.status,revision:m.revision,createdAt:m.createdAt,expiresAt:m.expiresAt,signed:m.people.filter(p=>p.signedAt).length,total:m.people.length,people:m.people.map((p,i)=>({id:p.id,name:p.name,number:i+1,signedAt:p.signedAt||null,placement:p.placement||null,...(owner?{email:p.email,token:m.id+'.'+p.token}:{} )}))}}
function sharedCommit_(r,m){const folder=personalDrive_().getFolderById(m.folderId),file=folder.createFile(Utilities.newBlob(JSON.stringify(m),'application/json','revision-'+m.revision+'-'+Utilities.getUuid()+'.json'));try{for(const person of m.people)writeProp_('route:'+hash_(m.id+'.'+person.token),{id:personalContext_.account.id});r.sheet.getRange(r.row,1,1,SHARED_HEADERS_.length).setValues([[m.id,file.getId(),m.createdAt,m.status,m.revision,/^[=+@-]/.test(m.title)?"'"+m.title:m.title,m.originalId,m.pdfId,m.people.length,m.people.filter(p=>p.signedAt).length,new Date().toISOString()]]);personalSheets_().flush();return file.getId()}catch(e){personalContext_.workspace=null;throw e}}
function sharedPng_(base64,label){const max=label?65536:131072;if(typeof base64!=='string'||base64.length>Math.ceil(max/3)*4||!/^[A-Za-z0-9+/]+={0,2}$/.test(base64))sharedError_('קובץ החתימה אינו תקין או גדול מדי.');const b=Utilities.base64Decode(base64);if(b.length<33||b.length>max||[137,80,78,71,13,10,26,10].some((v,i)=>(b[i]&255)!==v))sharedError_('נדרשת חתימה בפורמט PNG.');const u=i=>((b[i]&255)*16777216+(b[i+1]&255)*65536+(b[i+2]&255)*256+(b[i+3]&255)),w=u(16),h=u(20);if(w<1||h<1||w>(label?1000:2000)||h>(label?200:1000)||w*h>2000000)sharedError_('מידות החתימה אינן תקינות.');return b}
function sharedPlacement_(p){if(!p||!Number.isInteger(p.page)||p.page<1||p.page>1000||['x','y','w','h'].some(k=>typeof p[k]!=='number'||!Number.isFinite(p[k]))||p.x<0||p.y<0||p.w<.05||p.w>.7||p.h<.025||p.h>.35||p.x+p.w>1.000001||p.y+p.h>1.000001)sharedError_('מיקום החתימה מחוץ לגבולות העמוד.');return {page:p.page,x:p.x,y:p.y,w:p.w,h:p.h}}
function sharedOverlaps_(a,b){return a.page===b.page&&a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y}
function sharedOwnerDispatch(accessToken,action,payload){const ownerId=appOwner_(accessToken);payload=payload||{};if(action==='shared-version')return {version:1,runtimeReady:sharedEnsureRuntime_(),storage:'drive',maxSigners:50,maxPdfBytes:LIMIT_BYTES_};const lock=LockService.getScriptLock();lock.waitLock(30000);try{personalRefreshContext_();
 if(action==='shared-create'){if(!sharedEnsureRuntime_())sharedError_('שירות ה-PDF עדיין בבדיקה. נסו שוב בעוד מספר שניות.');return sharedCreate_(ownerId,payload);}
 if(action==='shared-list'&&!personalSheets_().openById(config_().SHEET_ID).getSheetByName('SharedDocuments'))return [];
 if(action==='shared-list')return sharedSheet_().getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>sharedFind_(String(r[0])).meta).filter(m=>m.ownerId===ownerId).map(m=>sharedSummary_(m,true));
 const r=sharedFind_(payload.id);if(r.meta.ownerId!==ownerId)sharedError_('אין הרשאה למסמך זה.');
 if(action==='shared-download')return {title:r.meta.title,revision:r.meta.revision,base64:Utilities.base64Encode(personalDrive_().getFileById(r.meta.pdfId).getBlob().getBytes())};
 if(action==='shared-cancel'){const m=JSON.parse(JSON.stringify(r.meta));m.status='cancelled';sharedCommit_(r,m);return sharedSummary_(m,true)}
 sharedError_('פעולה לא נתמכת.');
 }finally{lock.releaseLock()}}
function sharedCreate_(ownerId,p){if(typeof p.creationId!=='string'||!/^[a-f0-9-]{36}$/.test(p.creationId))sharedError_('מזהה הבקשה אינו תקין.');const fingerprint=hash_(JSON.stringify({base64:p.base64,title:p.title,people:p.people})),sheet=sharedSheet_(true),existing=sheet.getDataRange().getValues().slice(1).some(r=>r[0]===p.creationId);if(existing){const m=sharedFind_(p.creationId).meta;if(m.ownerId===ownerId&&m.creationFingerprint===fingerprint)return sharedSummary_(m,true);sharedError_('מזהה הבקשה כבר בשימוש.');}const bytes=pdfBytes_(p.base64),people=p.people;if(!Array.isArray(people)||people.length<2||people.length>50)sharedError_('יש לבחור בין 2 ל-50 חותמים.');const seen={};const validated=people.map(person=>{const name=String(person.name||'').trim(),email=String(person.email||'').trim().toLowerCase();if(!name||name.length>120||email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))sharedError_('יש להזין שם וכתובת מייל תקינים.');const key=email||name;if(seen[key])sharedError_('אותו חותם מופיע פעמיים.');seen[key]=true;return {name,email,labelBytes:sharedPng_(person.label,true)}});
 const rootId=personalContext_.account.sharedId;const id=p.creationId,folder=personalDrive_().getFolderById(rootId).createFolder(id);let committed=false,commitAttempted=false;try{const title=String(p.title||'document.pdf').replace(/[\x00-\x1f]/g,'').slice(0,180),original=folder.createFile(Utilities.newBlob(bytes,'application/pdf',title)),createdAt=new Date().toISOString(),m={id,ownerId,creationFingerprint:fingerprint,title,folderId:folder.getId(),originalId:original.getId(),pdfId:original.getId(),createdAt,expiresAt:new Date(Date.now()+30*86400000).toISOString(),revision:0,status:'pending',people:validated.map((person,i)=>{const token=Utilities.getUuid()+Utilities.getUuid(),label=folder.createFile(Utilities.newBlob(person.labelBytes,'image/png','signer-'+(i+1)+'-name.png'));return {id:Utilities.getUuid(),name:person.name,email:person.email,token,tokenHash:hash_(token),labelId:label.getId()}})};const r={sheet,row:sheet.getLastRow()+1};commitAttempted=true;sharedCommit_(r,m);committed=true;return sharedSummary_(m,true)}finally{if(!committed&&!commitAttempted)folder.setTrashed(true)}}
function sharedPublicDispatch(action,payload){payload=payload||{};if(typeof payload.token!=='string'||!/^[a-f0-9-]{36}\.[a-f0-9-]{72}$/.test(payload.token))sharedError_('הקישור אינו תקין.');const r=action==='shared-public-sign'?null:sharedResolve_(payload.token);
 if(action==='shared-public-read'){const f=personalDrive_().getFileById(r.meta.pdfId);if(f.getSize()>20*1024*1024)sharedError_('המסמך גדול מדי לפתיחה בדפדפן.');return {...sharedSummary_(r.meta,false),signerId:r.person.id,alreadySigned:!!r.person.signedAt,base64:Utilities.base64Encode(f.getBlob().getBytes())}}
 if(action==='shared-public-result'){if(typeof payload.job!=='string'||!/^[a-f0-9-]{36}$/.test(payload.job))sharedError_('בקשה לא תקינה.');const value=CacheService.getScriptCache().get('shared-job:'+hash_(payload.token)+':'+payload.job);return value?JSON.parse(value):{state:'unknown'}}
 if(action!=='shared-public-sign')sharedError_('פעולה לא נתמכת.');if(typeof payload.submissionId!=='string'||!/^[a-f0-9-]{36}$/.test(payload.submissionId))sharedError_('מזהה השליחה אינו תקין.');sharedPng_(payload.png,false);sharedPlacement_(payload.placement);const job=Utilities.getUuid(),key='shared-job:'+hash_(payload.token)+':'+job;CacheService.getScriptCache().put(key,JSON.stringify({state:'pending'}),600);
 // All awaited work is CPU/fulfilled promises; V8 drains these microtasks before execution ends.
 // Polling avoids returning a Promise through google.script.run's synchronous serialization.
 sharedSubmit_(payload).then(result=>CacheService.getScriptCache().put(key,JSON.stringify({state:'done',revision:result.revision}),600)).catch(e=>CacheService.getScriptCache().put(key,JSON.stringify({state:'error',code:e.code||'SUBMISSION_FAILED',message:e.message||'שמירת החתימה נכשלה.'}),600));return {job};}
function sharedPdfLib_(){if(sharedPdfLibrary_)return sharedPdfLibrary_;const source=UrlFetchApp.fetch('https://roishlomo-teleprompter.github.io/Sign-PDF/vendor/pdf-lib.min.js').getContentText();if(hash_(source)!=='0f9a5cad07941f0826586c94e089d89b918c46e5c17cf2d5a3c6f666e3bc694f')sharedError_('לא ניתן לאמת את ספריית ה-PDF.');const module={exports:{}};sharedPdfLibrary_=new Function('module','exports',source+';return module.exports;')(module,module.exports);return sharedPdfLibrary_}
function sharedBounds_(page){const media=page.getMediaBox(),crop=page.getCropBox(),x=Math.max(media.x,crop.x),y=Math.max(media.y,crop.y),right=Math.min(media.x+media.width,crop.x+crop.width),top=Math.min(media.y+media.height,crop.y+crop.height);return right>x&&top>y?{x,y,width:right-x,height:top-y}:media}
function sharedPoint_(page,x,y){const box=sharedBounds_(page),w=box.width,h=box.height,rotation=((page.getRotation().angle%360)+360)%360;if(rotation%90)sharedError_('סיבוב העמוד אינו נתמך.');const p=rotation===90?{x:y*w,y:x*h}:rotation===180?{x:(1-x)*w,y:y*h}:rotation===270?{x:(1-y)*w,y:(1-x)*h}:{x:x*w,y:(1-y)*h};return {x:box.x+p.x,y:box.y+p.y,rotation}}
function sharedDrawImage_(lib,page,img,box){const rot=((page.getRotation().angle%360)+360)%360,bounds=sharedBounds_(page),viewW=rot%180?bounds.height:bounds.width,viewH=rot%180?bounds.width:bounds.height,fit=Math.min(box.w*viewW/img.width,box.h*viewH/img.height),w=img.width*fit,h=img.height*fit,left=box.x+(box.w-w/viewW)/2,top=box.y+(box.h-h/viewH)/2,at=sharedPoint_(page,left,top+h/viewH);page.drawImage(img,{x:at.x,y:at.y,width:w,height:h,rotate:lib.degrees(rot)})}
async function sharedRender_(m){const lib=sharedPdfLib_(),bytes=new Uint8Array(personalDrive_().getFileById(m.originalId).getBlob().getBytes().map(b=>b&255)),doc=await lib.PDFDocument.load(bytes,{parseSpeed:Infinity}),font=await doc.embedFont(lib.StandardFonts.Helvetica);for(let i=0;i<m.people.length;i++){const person=m.people[i];if(!person.signedAt)continue;const b=person.placement,page=doc.getPages()[b.page-1];if(!page)sharedError_('העמוד שנבחר אינו קיים במסמך.');const png=await doc.embedPng(new Uint8Array(personalDrive_().getFileById(person.pngId).getBlob().getBytes().map(v=>v&255))),label=await doc.embedPng(new Uint8Array(personalDrive_().getFileById(person.labelId).getBlob().getBytes().map(v=>v&255)));sharedDrawImage_(lib,page,png,{...b,h:b.h*.68});sharedDrawImage_(lib,page,label,{...b,y:b.y+b.h*.68,h:b.h*.2});const at=sharedPoint_(page,b.x,b.y+b.h*.98),text='#'+(i+1)+' '+person.signedAt.slice(0,19).replace('T',' ')+' UTC',rot=at.rotation,bounds=sharedBounds_(page),viewW=rot%180?bounds.height:bounds.width,size=Math.min(7,b.w*viewW/font.widthOfTextAtSize(text,1));page.drawText(text,{x:at.x,y:at.y,size,font,rotate:lib.degrees(rot),color:lib.rgb(.25,.32,.43)})}const saved=await doc.save({objectsPerTick:Infinity});if(saved.length>20*1024*1024)sharedError_('המסמך החתום גדול מדי.');return Array.from(saved,b=>b>127?b-256:b)}
function sharedAcquireLock_(lock){lock.waitLock(30000);personalRefreshContext_()}
async function sharedSubmit_(payload){const lock=LockService.getScriptLock();await sharedAcquireLock_(lock);const created=[];let committed=false,commitAttempted=false;try{const r=sharedResolve_(payload.token),png=sharedPng_(payload.png,false),placement=sharedPlacement_(payload.placement),fingerprint=hash_(JSON.stringify({png:payload.png,placement}));if(r.person.signedAt){if(r.person.submissionId===payload.submissionId&&r.person.fingerprint===fingerprint)return {revision:r.meta.revision};sharedError_('כבר חתמת על מסמך זה.');}if(r.meta.people.some(p=>p.placement&&sharedOverlaps_(p.placement,placement)))sharedError_('כבר קיימת חתימה במיקום הזה. יש לבחור מקום פנוי.','SIGNATURE_OVERLAP');const m=JSON.parse(JSON.stringify(r.meta)),person=m.people.find(p=>p.id===r.person.id),folder=personalDrive_().getFolderById(m.folderId),image=folder.createFile(Utilities.newBlob(png,'image/png','signature-'+person.id+'.png'));created.push(image);Object.assign(person,{pngId:image.getId(),placement,signedAt:new Date().toISOString(),submissionId:payload.submissionId,fingerprint});const pdf=await sharedRender_(m),file=folder.createFile(Utilities.newBlob(pdf,'application/pdf',m.title.replace(/\.pdf$/i,'')+'-signed-v'+(m.revision+1)+'.pdf'));created.push(file);m.pdfId=file.getId();m.revision++;m.status=m.people.every(p=>p.signedAt)?'completed':'pending';commitAttempted=true;sharedCommit_(r,m);committed=true;return {revision:m.revision}}finally{if(!committed&&!commitAttempted)for(const f of created){try{f.setTrashed(true)}catch{}}lock.releaseLock()}}

function sharedEnsureRuntime_(){const props=PropertiesService.getScriptProperties();if(props.getProperty('SHARED_RUNTIME_VERIFIED')==='1')return true;const cache=CacheService.getScriptCache();if(!cache.get('shared-runtime-probe')){cache.put('shared-runtime-probe','pending',30);(async()=>{try{const lib=sharedPdfLib_(),doc=await lib.PDFDocument.create();doc.addPage([100,100]);const result=await doc.save({objectsPerTick:Infinity});if(result.length<20||String.fromCharCode.apply(null,Array.from(result.slice(0,5)))!=='%PDF-')throw new Error('PDF runtime probe failed');props.setProperty('SHARED_RUNTIME_VERIFIED','1');cache.put('shared-runtime-probe','done',30)}catch(e){cache.put('shared-runtime-probe','error',30)}})()}return false}
